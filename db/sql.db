-- 1. Crear Base de Datos
CREATE DATABASE IF NOT EXISTS agencia_viajes 
CHARACTER SET utf8mb4 
COLLATE utf8mb4_unicode_ci;

-- 2. Seleccionar la Base de Datos
USE agencia_viajes;

-- 3. Crear tabla viajes
CREATE TABLE IF NOT EXISTS viajes (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(255) NULL,
    precio VARCHAR(255) NULL,
    fecha_ida DATETIME NULL,
    fecha_vuelta DATETIME NULL,
    imagen VARCHAR(255) NULL,
    descripcion VARCHAR(255) NULL,
    disponibles VARCHAR(255) NULL,
    slug VARCHAR(255) NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- 4. Crear tabla testimoniales
CREATE TABLE IF NOT EXISTS testimoniales (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(255) NULL,
    correo VARCHAR(255) NULL,
    mensaje VARCHAR(255) NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

